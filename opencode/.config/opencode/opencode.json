{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "grep *": "allow",
      "echo *": "allow",
      "find *": "allow",
      "git commit *": "deny",
      "git push *": "deny",
    },
    "doom_loop": "deny"
  },
  "provider": {
    "dmr": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Docker Model Runner",
      "options": {
        "baseURL": "http://localhost:12434/v1"
      }
    }
  }
}
